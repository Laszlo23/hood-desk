# Robinhood Chain RPC (optional — falls back to public RPC)
# Default: https://rpc.mainnet.chain.robinhood.com
VITE_RH_RPC=

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
# Required for mobile Safari / browsers without an injected wallet.
VITE_WC_PROJECT_ID=

# $HOOD ERC-20 address on Robinhood Chain (4663) — optional until deploy
# After hood-token forge deploy, paste the address here.
VITE_HOOD_TOKEN=

# --- Stripe (Checkout subscriptions) ---
# Frontend (safe to expose):
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_STARTER=
VITE_STRIPE_PRICE_DESK=
VITE_STRIPE_PRICE_DESK_PLUS=
# Optional display price overrides (USD monthly numbers). Defaults: 4.99 / 9.99 / 19.99
# VITE_PRICE_STARTER=4.99
# VITE_PRICE_DESK=9.99
# VITE_PRICE_DESK_PLUS=19.99
# Optional API base if not using Vite proxy (default /api → :8787)
# VITE_STRIPE_API_BASE=/api

# Server-only (loaded by server/index.js via dotenv) — NEVER commit real values
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PORT=8787
# CORS_ORIGIN=http://localhost:5182

# DogiHood ERC-721 on Robinhood Chain (4663) — featured pack NFT
# Default (OpenSea-confirmed): 0x9273f6d13c45a18c9664cecf0e7ff1f7aa9440fa
# Not the DIH ERC-20. Override only if the collection migrates.
VITE_DOGIHOOD_NFT=0x9273f6d13c45a18c9664cecf0e7ff1f7aa9440fa

# Hood Seeder ERC-721 on Robinhood Chain (4663) — early supporter pass
# Deploy via contracts/hood-seeder/ then set this to the contract address.
# Leave empty until deployed.
VITE_HOOD_SEEDER_NFT=
